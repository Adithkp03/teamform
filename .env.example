# Postgres connection string used by the API, migrations and seed scripts.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/teamform
# HS256 secret for API JWTs. In production this is the Supabase project JWT secret,
# so Supabase Auth access tokens verify directly. Locally any random string works.
JWT_SECRET=dev-secret-change-me
# Allows POST /api/auth/dev-login (issues JWTs without Supabase). NEVER true in production.
ALLOW_DEV_LOGIN=true
# Public URL of the API (used by the web app at build time).
VITE_API_URL=http://localhost:3000
# Supabase realtime (web app only, optional in dev).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
