# Postgres connection string used by the API, migrations and seed scripts.
# Production: the Neon pooled connection string (host ...-pooler...).
DATABASE_URL=postgres://postgres:postgres@localhost:5432/teamform
# HS256 secret for API JWTs (production value lives in the deployment env only).
JWT_SECRET=dev-secret-change-me
# Allows POST /api/auth/dev-login (issues a JWT for any user_id). NEVER true in production.
ALLOW_DEV_LOGIN=true
# Realtime mode: 'poll' (default; serverless-safe durable outbox, ~1s) or
# 'listen' (LISTEN/NOTIFY true push; self-hosted single-process deployments).
REALTIME_MODE=poll
# Comma-separated allowed web origins for CORS (production: the web app URL).
CORS_ORIGIN=http://localhost:5173
# Public URL of the API (used by the web app at build time; empty = same origin).
VITE_API_URL=http://localhost:3000
# Firebase Auth (production identity provider). Project ID + public web API
# key from the Firebase console; both are non-secret client-side identifiers.
# Without them the API refuses firebase exchanges with 503 firebase_not_configured.
FIREBASE_PROJECT_ID=
FIREBASE_WEB_API_KEY=
# Offline test seam for the e2e suite; hard-refused when VERCEL env is set.
FIREBASE_TEST_MODE=
